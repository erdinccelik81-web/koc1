                            <label className="text-slate-600 font-medium">Fizik (14)</label>
                            <input
                              type="number" step="0.25" placeholder="0"
                              value={examForm.aytFizik}
                              onChange={(e) => setExamForm({ ...examForm, aytFizik: e.target.value })}
                              className="w-full bg-white border border-slate-300 rounded-lg px-2.5 py-1.5 mt-0.5 focus:ring-1 focus:ring-teal-500"
                            />
                          </div>
                          <div>
                            <label className="text-slate-600 font-medium">Kimya (13)</label>
                            <input
                              type="number" step="0.25" placeholder="0"
                              value={examForm.aytKimya}
                              onChange={(e) => setExamForm({ ...examForm, aytKimya: e.target.value })}
                              className="w-full bg-white border border-slate-300 rounded-lg px-2.5 py-1.5 mt-0.5 focus:ring-1 focus:ring-teal-500"
                            />
                          </div>
                          <div>
                            <label className="text-slate-600 font-medium">Biyoloji (13)</label>
                            <input
                              type="number" step="0.25" placeholder="0"
                              value={examForm.aytBiyo}
                              onChange={(e) => setExamForm({ ...examForm, aytBiyo: e.target.value })}
                              className="w-full bg-white border border-slate-300 rounded-lg px-2.5 py-1.5 mt-0.5 focus:ring-1 focus:ring-teal-500"
                            />
                          </div>
                        </div>
                      )}

                      {(currentStudent.yksField === 'EA' || currentStudent.yksField === 'SOZEL') && (
                        <div className="grid grid-cols-2 gap-2 text-xs">
                          <div>
                            <label className="text-slate-600 font-medium">AYT Mat (40)</label>
                            <input
                              type="number" step="0.25" placeholder="0"
                              value={examForm.aytMat}
                              onChange={(e) => setExamForm({ ...examForm, aytMat: e.target.value })}
                              className="w-full bg-white border border-slate-300 rounded-lg px-2.5 py-1.5 mt-0.5 focus:ring-1 focus:ring-teal-500"
                            />
                          </div>
                          <div>
                            <label className="text-slate-600 font-medium">T. Edebiyatı (24)</label>
                            <input
                              type="number" step="0.25" placeholder="0"
                              value={examForm.aytEdebiyat}
                              onChange={(e) => setExamForm({ ...examForm, aytEdebiyat: e.target.value })}
                              className="w-full bg-white border border-slate-300 rounded-lg px-2.5 py-1.5 mt-0.5 focus:ring-1 focus:ring-teal-500"
                            />
                          </div>
                          <div>
                            <label className="text-slate-600 font-medium">Tarih-1 (10)</label>
                            <input
                              type="number" step="0.25" placeholder="0"
                              value={examForm.aytTarih1}
                              onChange={(e) => setExamForm({ ...examForm, aytTarih1: e.target.value })}
                              className="w-full bg-white border border-slate-300 rounded-lg px-2.5 py-1.5 mt-0.5 focus:ring-1 focus:ring-teal-500"
                            />
                          </div>
                          <div>
                            <label className="text-slate-600 font-medium">Coğrafya-1 (6)</label>
                            <input
                              type="number" step="0.25" placeholder="0"
                              value={examForm.aytCogr1}
                              onChange={(e) => setExamForm({ ...examForm, aytCogr1: e.target.value })}
                              className="w-full bg-white border border-slate-300 rounded-lg px-2.5 py-1.5 mt-0.5 focus:ring-1 focus:ring-teal-500"
                            />
                          </div>
                        </div>
                      )}
                    </div>
                  </div>
                )}

                {currentStudent.track === 'LGS' && (
                  <div className="bg-slate-50 p-3.5 rounded-xl border border-slate-200 space-y-3">
                    <span className="font-extrabold text-xs text-amber-900 uppercase tracking-wider block">LGS Ders Netleri (Max 90)</span>
                    <div className="grid grid-cols-2 gap-2 text-xs">
                      <div>
                        <label className="text-slate-600 font-medium">Türkçe (20)</label>
                        <input
                          type="number" step="0.25" placeholder="0"
                          value={examForm.lgsTurkce}
                          onChange={(e) => setExamForm({ ...examForm, lgsTurkce: e.target.value })}
                          className="w-full bg-white border border-slate-300 rounded-lg px-2.5 py-1.5 mt-0.5"
                        />
                      </div>
                      <div>
                        <label className="text-slate-600 font-medium">Matematik (20)</label>
                        <input
                          type="number" step="0.25" placeholder="0"
                          value={examForm.lgsMat}
                          onChange={(e) => setExamForm({ ...examForm, lgsMat: e.target.value })}
                          className="w-full bg-white border border-slate-300 rounded-lg px-2.5 py-1.5 mt-0.5"
                        />
                      </div>
                      <div>
                        <label className="text-slate-600 font-medium">Fen Bilimleri (20)</label>
                        <input
                          type="number" step="0.25" placeholder="0"
                          value={examForm.lgsFen}
                          onChange={(e) => setExamForm({ ...examForm, lgsFen: e.target.value })}
                          className="w-full bg-white border border-slate-300 rounded-lg px-2.5 py-1.5 mt-0.5"
                        />
                      </div>
                      <div>
                        <label className="text-slate-600 font-medium">T.C. İnkılap (10)</label>
                        <input
                          type="number" step="0.25" placeholder="0"
                          value={examForm.lgsInkilap}
                          onChange={(e) => setExamForm({ ...examForm, lgsInkilap: e.target.value })}
                          className="w-full bg-white border border-slate-300 rounded-lg px-2.5 py-1.5 mt-0.5"
                        />
                      </div>
                      <div>
                        <label className="text-slate-600 font-medium">Din Kültürü (10)</label>
                        <input
                          type="number" step="0.25" placeholder="0"
                          value={examForm.lgsDin}
                          onChange={(e) => setExamForm({ ...examForm, lgsDin: e.target.value })}
                          className="w-full bg-white border border-slate-300 rounded-lg px-2.5 py-1.5 mt-0.5"
                        />
                      </div>
                      <div>
                        <label className="text-slate-600 font-medium">Yabancı Dil (10)</label>
                        <input
                          type="number" step="0.25" placeholder="0"
                          value={examForm.lgsIng}
                          onChange={(e) => setExamForm({ ...examForm, lgsIng: e.target.value })}
                          className="w-full bg-white border border-slate-300 rounded-lg px-2.5 py-1.5 mt-0.5"
                        />
                      </div>
                    </div>
                  </div>
                )}

                <div className="bg-indigo-900 text-white p-3.5 rounded-xl space-y-2">
                  <div className="flex justify-between items-center text-xs">
                    <span>Otomatik Toplam Net:</span>
                    <span className="font-black text-teal-300 text-base">{calculatedFormNets.totalNet} Net</span>
                  </div>
                  <div>
                    <label className="block text-[11px] font-medium text-indigo-200 mb-1">
                      Yerleştirme Puanı (Boş bırakılırsa otomatik hesaplanır)
                    </label>
                    <input
                      type="number"
                      placeholder={`Tahmini: ~${calculatedFormNets.estPoints} Puan`}
                      value={examForm.totalPoints}
                      onChange={(e) => setExamForm({ ...examForm, totalPoints: e.target.value })}
                      className="w-full bg-white/10 border border-white/20 rounded-lg px-3 py-1.5 text-sm text-white placeholder-slate-300 focus:outline-none"
                    />
                  </div>
                </div>

                <button
                  type="submit"
                  className="w-full bg-indigo-600 hover:bg-indigo-700 text-white font-semibold py-3 rounded-xl shadow-md transition flex items-center justify-center gap-2 text-sm"
                >
                  <TrendingUp className="w-4 h-4" />
                  <span>Denemeyi Kaydet ve Sıralamayı Hesapla</span>
                </button>
              </form>
            </div>

            <div className="lg:col-span-7 space-y-6">
              
              <div className="bg-white p-6 rounded-2xl shadow-sm border border-slate-200">
                <div className="flex flex-col sm:flex-row sm:items-center justify-between gap-3 mb-4">
                  <div>
                    <h3 className="font-bold text-slate-900 text-lg flex items-center gap-2">
                      <Award className="w-5 h-5 text-amber-500" />
                      Deneme Sıralamaları & Tahmini YKS/LGS Dereceleri
                    </h3>
                    <p className="text-xs text-slate-500 mt-0.5">
                      ÖSYM 2024 ve 2025 Yıl Yığılım Verilerine göre otomatik tahmini başarı sırası hesaplanmıştır.
                    </p>
                  </div>
                  <div className="text-xs bg-amber-50 text-amber-900 border border-amber-200 px-3 py-1 rounded-lg font-bold self-start">
                    Alan: {currentStudent.yksField || 'SAYISAL'}
                  </div>
                </div>

                {rankedExams.length === 0 ? (
                  <p className="text-center py-10 text-sm text-slate-400 italic">Henüz deneme sonucu girilmemiş.</p>
                ) : (
                  <div className="overflow-x-auto">
                    <table className="w-full text-left border-collapse">
                      <thead>
                        <tr className="border-b border-slate-200 text-[11px] font-extrabold uppercase text-slate-400 bg-slate-50">
                          <th className="py-3 px-3">Koçluk Sırası</th>
                          <th className="py-3 px-3">Deneme Adı</th>
                          <th className="py-3 px-3 text-center">Netler</th>
                          <th className="py-3 px-3 text-right">Puan</th>
                          <th className="py-3 px-3 text-center bg-indigo-50/70 text-indigo-900">2024 Tahmini Sıra</th>
                          <th className="py-3 px-3 text-center bg-teal-50/70 text-teal-900">2025 Tahmini Sıra</th>
                          <th className="py-3 px-3 text-right">Sil</th>
                        </tr>
                      </thead>
                      <tbody className="divide-y divide-slate-100 text-sm font-medium">
                        {rankedExams.map((exam) => (
                          <tr key={exam.id} className="hover:bg-slate-50/80 transition">
                            <td className="py-3.5 px-3">
                              <span className={`inline-flex items-center justify-center w-7 h-7 rounded-full text-xs font-black ${
                                exam.rank === 1 ? 'bg-amber-100 text-amber-800 border border-amber-300' :
                                exam.rank === 2 ? 'bg-slate-200 text-slate-800' :
                                exam.rank === 3 ? 'bg-amber-800/10 text-amber-900' : 'bg-slate-100 text-slate-600'
                              }`}>
                                #{exam.rank}
                              </span>
                            </td>
                            <td className="py-3.5 px-3">
                              <div className="font-bold text-slate-800">{exam.title}</div>
                              <div className="text-[11px] text-slate-400">{exam.date}</div>
                            </td>
                            <td className="py-3.5 px-3 text-center">
                              {currentStudent.track === 'YKS' ? (
                                <div className="text-xs">
                                  <span className="font-extrabold text-indigo-600">TYT: {exam.tytNet}</span>
                                  <span className="mx-1 text-slate-300">|</span>
                                  <span className="font-extrabold text-teal-600">AYT: {exam.aytNet}</span>
                                </div>
                              ) : (
                                <span className="font-extrabold text-indigo-600 text-xs">Toplam: {exam.totalNet}</span>
                              )}
                            </td>
                            <td className="py-3.5 px-3 text-right font-black text-slate-900">
                              {exam.totalPoints} P
                            </td>
                            <td className="py-3.5 px-3 text-center bg-indigo-50/30 font-black text-indigo-900 text-xs">
                              {exam.rank2024}
                            </td>
                            <td className="py-3.5 px-3 text-center bg-teal-50/30 font-black text-teal-900 text-xs">
                              {exam.rank2025}
                            </td>
                            <td className="py-3.5 px-3 text-right">
                              <button
                                onClick={() => {
                                  updateStudentData(s => ({
                                    ...s,
                                    exams: s.exams.filter(e => e.id !== exam.id)
                                  }));
                                }}
                                className="text-slate-300 hover:text-rose-600 transition"
                              >
                                <Trash2 className="w-4 h-4" />
                              </button>
                            </td>
                          </tr>
                        ))}
                      </tbody>
                    </table>
                  </div>
                )}
              </div>

              <div className="bg-slate-100 p-4 rounded-xl border border-slate-200 flex items-start gap-3">
                <Info className="w-5 h-5 text-indigo-600 shrink-0 mt-0.5" />
                <p className="text-xs text-slate-600 leading-relaxed">
                   Tahmini başarı sıralamaları, <strong>ÖSYM 2024 ve 2025 YKS/LGS yığılım verileri ve standart sapma eğrileri</strong> temel alınarak hesaplanmaktadır. Öğrencinin alanına ({currentStudent.yksField || 'SAYISAL'}) göre puan karşılığı yaklaşık sıra dilimi gösterilir.
                </p>
              </div>

            </div>

          </div>
        )}

      </main>
    </div>
  );
}
