// --- YKS & LGS ESTIMATED RANKING CALCULATION ENGINE ---
const estimateYKSRanking = (trackType, score, year) => {
  if (!score || score <= 0) return '-';
  
  let benchmarks = [];
  if (trackType === 'SAYISAL') {
    benchmarks = [
      [550, 1, 1], [530, 250, 200], [500, 1850, 1500], [470, 7200, 6100], 
      [440, 21000, 18200], [410, 43500, 39000], [380, 76000, 69000], 
      [350, 120000, 110000], [300, 225000, 205000], [250, 390000, 360000], [200, 650000, 610000]
    ];
  } else if (trackType === 'EA') {
    benchmarks = [
      [540, 1, 1], [500, 380, 310], [460, 2900, 2400], [420, 12500, 10500],
      [380, 38000, 33000], [340, 92000, 82000], [300, 195000, 175000], 
      [260, 380000, 345000], [200, 820000, 760000]
    ];
  } else if (trackType === 'SOZEL') {
    benchmarks = [
      [530, 1, 1], [480, 450, 380], [440, 3100, 2600], [400, 14000, 12000],
      [360, 48000, 41000], [320, 115000, 102000], [280, 240000, 215000], [220, 580000, 520000]
    ];
  } else {
    benchmarks = [
      [500, 1, 1], [470, 2500, 2100], [430, 18000, 15500], [390, 62000, 54000],
      [350, 145000, 130000], [310, 280000, 250000], [270, 490000, 440000], [220, 950000, 870000]
    ];
  }

  const colIdx = year === 2024 ? 1 : 2;

  if (score >= benchmarks[0][0]) return `~${benchmarks[0][colIdx]}`;
  const last = benchmarks[benchmarks.length - 1];
  if (score <= last[0]) return `>${last[colIdx]}`;

  for (let i = 0; i < benchmarks.length - 1; i++) {
    const [s1, r1_24, r1_25] = benchmarks[i];
    const [s2, r2_24, r2_25] = benchmarks[i + 1];
    const r1 = year === 2024 ? r1_24 : r1_25;
    const r2 = year === 2024 ? r2_24 : r2_25;

    if (score <= s1 && score >= s2) {
      const ratio = (s1 - score) / (s1 - s2);
      const estRank = Math.round(r1 + ratio * (r2 - r1));
      return `~${estRank.toLocaleString('tr-TR')}`;
    }
  }
  return '-';
};

