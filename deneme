export default function App() {
  const [students, setStudents] = useState(INITIAL_STUDENTS);
  const [activeStudentId, setActiveStudentId] = useState(INITIAL_STUDENTS[0].id);
  const [activeTab, setActiveTab] = useState('weekly');

  const [selectedSubject, setSelectedSubject] = useState('');
  const [selectedTopic, setSelectedTopic] = useState('');
  const [selectedDay, setSelectedDay] = useState('Pazartesi');
  const [newResourceName, setNewResourceName] = useState('');
  
  const [examForm, setExamForm] = useState({
    title: '',
    date: new Date().toISOString().split('T')[0],
    totalPoints: '',
    tytTurkce: '', tytMat: '', tytSosyal: '', tytFen: '',
    aytMat: '', aytFizik: '', aytKimya: '', aytBiyo: '',
    aytEdebiyat: '', aytTarih1: '', aytCogr1: '',
    lgsTurkce: '', lgsMat: '', lgsFen: '', lgsInkilap: '', lgsDin: '', lgsIng: ''
  });

  const currentStudent = useMemo(() => {
    return students.find(s => s.id === activeStudentId) || students[0];
  }, [students, activeStudentId]);

  const updateStudentData = (updater) => {
    setStudents(prev => prev.map(s => s.id === currentStudent.id ? updater(s) : s));
  };

  const availableSubjects = useMemo(() => {
    return Object.keys(MASTER_CURRICULUM[currentStudent.track] || {});
  }, [currentStudent.track]);

  const availableTopics = useMemo(() => {
    if (!selectedSubject) return [];
    return MASTER_CURRICULUM[currentStudent.track][selectedSubject] || [];
  }, [currentStudent.track, selectedSubject]);

  const progressStats = useMemo(() => {
    const totalAssigned = currentStudent.weeklyTargets.length;
    const completedAssigned = currentStudent.weeklyTargets.filter(t => t.status === 'completed').length;
    const weeklyPercent = totalAssigned === 0 ? 0 : Math.round((completedAssigned / totalAssigned) * 100);

    const subjectBreakdown = {};
    availableSubjects.forEach(sub => {
      const subTargets = currentStudent.weeklyTargets.filter(t => t.subject === sub);
      const subCompleted = subTargets.filter(t => t.status === 'completed').length;
      subjectBreakdown[sub] = {
        total: subTargets.length,
        completed: subCompleted,
        percent: subTargets.length === 0 ? 0 : Math.round((subCompleted / subTargets.length) * 100)
      };
    });

    const resourceCompleted = currentStudent.resources.filter(r => r.completed).length;
    const resourceTotal = currentStudent.resources.length;
    const resourcePercent = resourceTotal === 0 ? 0 : Math.round((resourceCompleted / resourceTotal) * 100);

    return { weeklyPercent, completedAssigned, totalAssigned, subjectBreakdown, resourcePercent, resourceCompleted, resourceTotal };
  }, [currentStudent, availableSubjects]);

  const calculatedFormNets = useMemo(() => {
    const isYKS = currentStudent.track === 'YKS';
    if (isYKS) {
      const tytNet = (Number(examForm.tytTurkce)||0) + (Number(examForm.tytMat)||0) + (Number(examForm.tytSosyal)||0) + (Number(examForm.tytFen)||0);
      const aytNet = (Number(examForm.aytMat)||0) + (Number(examForm.aytFizik)||0) + (Number(examForm.aytKimya)||0) + (Number(examForm.aytBiyo)||0) + (Number(examForm.aytEdebiyat)||0) + (Number(examForm.aytTarih1)||0) + (Number(examForm.aytCogr1)||0);
      const totalNet = tytNet + aytNet;
      
      let estPoints = Number(examForm.totalPoints);
      if (!estPoints || estPoints === 0) {
        estPoints = Math.round(100 + (tytNet * 1.33) + (aytNet * 3.0));
      }
      return { tytNet, aytNet, totalNet, estPoints };
    } else {
      const totalNet = (Number(examForm.lgsTurkce)||0) + (Number(examForm.lgsMat)||0) + (Number(examForm.lgsFen)||0) + (Number(examForm.lgsInkilap)||0) + (Number(examForm.lgsDin)||0) + (Number(examForm.lgsIng)||0);
      let estPoints = Number(examForm.totalPoints);
      if (!estPoints || estPoints === 0) {
        estPoints = Math.round(200 + (totalNet * 3.3));
      }
      return { tytNet: 0, aytNet: 0, totalNet, estPoints };
    }
  }, [examForm, currentStudent.track]);

  const rankedExams = useMemo(() => {
    const sorted = [...currentStudent.exams].sort((a, b) => {
      const scoreA = Number(a.totalPoints || a.totalNet || 0);
      const scoreB = Number(b.totalPoints || b.totalNet || 0);
      return scoreB - scoreA;
    });

    const field = currentStudent.yksField || 'SAYISAL';

    return currentStudent.exams.map(exam => {
      const rankIndex = sorted.findIndex(s => s.id === exam.id);
      const pts = Number(exam.totalPoints || 0);
      return {
        ...exam,
        rank: rankIndex + 1,
        rank2024: estimateYKSRanking(field, pts, 2024),
        rank2025: estimateYKSRanking(field, pts, 2025)
      };
    });
  }, [currentStudent.exams, currentStudent.track, currentStudent.yksField]);

  const handleAddTargetTopic = () => {
    if (!selectedSubject || !selectedTopic) return;
    const targetId = `wt-${Date.now()}`;
    const newTarget = {
      id: targetId,
      subject: selectedSubject,
      topic: selectedTopic,
      status: 'pending',
      assignedDay: selectedDay
    };

    let newResourceList = [...currentStudent.resources];
    if (newResourceName.trim()) {
      newResourceList.push({
        id: `res-${Date.now()}`,
        title: newResourceName.trim(),
        subject: selectedSubject,
        topic: selectedTopic,
        completed: false
      });
    }

    updateStudentData(s => ({
      ...s,
      weeklyTargets: [...s.weeklyTargets, newTarget],
      resources: newResourceList
    }));

    setSelectedTopic('');
    setNewResourceName('');
  };

  const toggleTargetStatus = (id) => {
    updateStudentData(s => {
      const target = s.weeklyTargets.find(t => t.id === id);
      if (!target) return s;

      const nextStatus = target.status === 'completed' ? 'pending' : 'completed';
      const isNowCompleted = nextStatus === 'completed';

      const updatedResources = s.resources.map(res => {
        if (res.topic === target.topic && res.subject === target.subject) {
          return { ...res, completed: isNowCompleted };
        }
        return res;
      });

      const updatedTargets = s.weeklyTargets.map(t => t.id === id ? { ...t, status: nextStatus } : t);

      return {
        ...s,
        weeklyTargets: updatedTargets,
        resources: updatedResources
      };
    });
  };

  const removeTarget = (id) => {
    updateStudentData(s => ({
      ...s,
      weeklyTargets: s.weeklyTargets.filter(t => t.id !== id)
    }));
  };

  const handleAddExam = (e) => {
    e.preventDefault();
    if (!examForm.title) return;

    const detailNets = { ...examForm };
    delete detailNets.title;
    delete detailNets.date;
    delete detailNets.totalPoints;

    const newExam = {
      id: `ex-${Date.now()}`,
      title: examForm.title,
      date: examForm.date || new Date().toISOString().split('T')[0],
      detailNets,
      tytNet: calculatedFormNets.tytNet,
      aytNet: calculatedFormNets.aytNet,
      totalNet: calculatedFormNets.totalNet,
      totalPoints: calculatedFormNets.estPoints
    };

    updateStudentData(s => ({
      ...s,
      exams: [newExam, ...s.exams]
    }));

    setExamForm({
      title: '',
      date: new Date().toISOString().split('T')[0],
      totalPoints: '',
      tytTurkce: '', tytMat: '', tytSosyal: '', tytFen: '',
      aytMat: '', aytFizik: '', aytKimya: '', aytBiyo: '',
      aytEdebiyat: '', aytTarih1: '', aytCogr1: '',
      lgsTurkce: '', lgsMat: '', lgsFen: '', lgsInkilap: '', lgsDin: '', lgsIng: ''
    });
  };

  const toggleResource = (id) => {
    updateStudentData(s => ({
      ...s,
      resources: s.resources.map(r => r.id === id ? { ...r, completed: !r.completed } : r)
    }));
  };

  return (
    <div className="min-h-screen bg-slate-50 text-slate-800 flex flex-col font-sans selection:bg-indigo-500 selection:text-white">
      
      {/* HEADER NAVBAR */}
      <header className="bg-slate-900 text-white border-b border-slate-800 sticky top-0 z-30 shadow-md">
        <div className="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
          <div className="flex items-center space-x-3">
            <div className="bg-gradient-to-tr from-indigo-500 to-teal-400 p-2 rounded-xl shadow-lg">
              <Sparkles className="w-6 h-6 text-white" />
            </div>
            <div>
              <h1 className="font-bold text-lg leading-tight tracking-wide bg-clip-text text-transparent bg-gradient-to-r from-white to-slate-300">
                Koçluk & Öğrenci Takip Sistemi
              </h1>
              <p className="text-xs text-slate-400">LGS & YKS Otomatik Program Paneli</p>
            </div>
          </div>

          <div className="flex items-center space-x-3">
            <label className="text-xs font-semibold text-slate-400 hidden sm:inline">Aktif Öğrenci:</label>
            <div className="relative">
              <select 
                value={activeStudentId} 
                onChange={(e) => setActiveStudentId(e.target.value)}
                className="bg-slate-800 text-slate-100 font-medium text-sm rounded-lg px-3 py-1.5 border border-slate-700 focus:outline-none focus:ring-2 focus:ring-teal-400 shadow-sm cursor-pointer"
