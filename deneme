                  <option key={std.id} value={std.id}>
                    {std.name} ({std.track} - {std.yksField || 'Genel'})
                  </option>
                ))}
              </select>
            </div>

            <button 
              onClick={() => {
                const name = prompt('Yeni Öğrenci Adı:');
                if (!name) return;
                const track = prompt('Sınav Türü (LGS veya YKS):', 'YKS')?.toUpperCase() === 'LGS' ? 'LGS' : 'YKS';
                let field = 'SAYISAL';
                if (track === 'YKS') {
                  field = prompt('YKS Alanı (SAYISAL, EA, SOZEL, TYT):', 'SAYISAL')?.toUpperCase() || 'SAYISAL';
                }
                const newId = String(Date.now());
                const newStd = {
                  id: newId,
                  name,
                  track,
                  yksField: field,
                  target: 'Hedef Belirlenmedi',
                  weeklyTargets: [],
                  resources: [],
                  exams: []
                };
                setStudents([...students, newStd]);
                setActiveStudentId(newId);
              }}
              className="bg-indigo-600 hover:bg-indigo-500 text-white p-2 rounded-lg text-xs font-semibold flex items-center gap-1 transition shadow-sm"
              title="Yeni Öğrenci Ekle"
